TOKEN=[bot token]
APPID=[bot app id]
DDTDTOKEN=[does the dog die user token]
# optional, where the sqlite db lives (default data/noodle.db)
# DB_PATH=data/noodle.db

# movie night (all optional)
# MOVIENIGHT_TIME=21:00
# MOVIENIGHT_TZ=Europe/London
# MOVIENIGHT_HOURS=3
# voice/stage channel to host the event in, otherwise it's an "external" event
# MOVIENIGHT_CHANNEL_ID=
# MOVIENIGHT_LOCATION=movie night 🍿
