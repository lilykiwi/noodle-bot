{
  "name": "noodle-bot",
  "version": "0.1.0",
  "type": "module",
  "main": "src/main.ts",
  "license": "MIT",
  "dependencies": {
    "chalk": "^6.0.1",
    "discord.js": "^14.28.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bun": "^1.4.4",
    "eslint": "^10.15.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0"
  },
  "scripts": {
    "start": "bun src/main.ts",
    "dev": "bun --watch src/main.ts",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "check": "bun run typecheck && bun run lint && bun test"
  }
}
